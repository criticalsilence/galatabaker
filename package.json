{
  "name": "galatabaker",
  "version": "0.1.0",
  "private": true,
  "description": "Tezos baking & staking platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "overrides": {
      "bs58check": "3.0.1",
      "@airgap/beacon-core": "4.8.0",
      "@airgap/beacon-dapp": "4.8.1",
      "@airgap/beacon-transport-matrix": "4.8.0",
      "@airgap/beacon-transport-postmessage": "4.8.0",
      "@airgap/beacon-ui": "4.8.0",
      "@airgap/beacon-utils": "4.8.0",
      "@airgap/beacon-wallet": "4.8.1"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@eslint/js": "^9",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^3",
    "eslint-plugin-import": "^2",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "typescript": "^5.4",
    "typescript-eslint": "^8",
    "vitest": "^1"
  }
}
