# GalataBaker API — env şablonu.
#
# Kullanım:
#   cp .env.example .env  (gitignore'da)
#   Değerleri doldur
#
# Production'da Railway/Fly/etc. env üzerinden inject edilir.

# --- Database ---
# Local dev: docker-compose'daki galata-postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/galatabaker?schema=public"
# Test DB: ayrı DB, supertest + e2e flow için
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/galatabaker_test?schema=public"

# --- Redis (Adım 8'de cache için kullanılacak) ---
REDIS_URL="redis://localhost:6379"

# --- Server ---
PORT=3001
NODE_ENV=development
# CORS: virgülle ayrılmış origin listesi
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# --- Email (production) ---
RESEND_API_KEY="re_***"
EMAIL_FROM="GalataBaker <noreply@galatabaker.app>"

# --- Email ---
# Provider selection: noop (test/CI) | mailhog (local dev) | resend (prod)
EMAIL_PROVIDER="mailhog"
EMAIL_FROM_ADDRESS="noreply@galatabaker.local"
EMAIL_FROM_NAME="GalataBaker"

# MailHog SMTP (provider=mailhog)
EMAIL_SMTP_HOST="localhost"
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_SECURE="false"

# Resend (provider=resend) — production'da doldur
# RESEND_API_KEY="re_***"
# RESEND_API_URL="https://api.resend.com/emails"

# --- Internal callbacks (Adım 6 indexer) ---
# Indexer claim callback'leri için shared secret
INTERNAL_API_KEY="dev-internal-key-change-in-prod"

# --- Logging ---
LOG_LEVEL="log"
