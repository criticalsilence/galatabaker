# apps/indexer — public env vars (safe to commit). Copy to .env.

# TzKT base URL. Use the network that matches the rest of the stack.
#   bakingnet: https://api.bakingnet.tzkt.io
#   mainnet:   https://api.tzkt.io
TZKT_BASE_URL=https://api.bakingnet.tzkt.io

# Same Postgres as apps/api.
DATABASE_URL="postgresql://galata:***@localhost:5432/galatabaker?schema=public"

# How often each cycle runs (ms). 30s is a good default for testnet.
INTERVAL_MS=30000

# TzKT page size for /v1/operations (max 1000).
BATCH_SIZE=1000

# Logging: debug|log|warn|error
LOG_LEVEL=info
