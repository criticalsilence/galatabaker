# ── General ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── App URLs ───────────────────────────────────────────────
WEB_URL=http://localhost:3001
API_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://galata:changeme@localhost:5432/galatabaker

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Tezos (Ushuaia testnet) ───────────────────────────────
TEZOS_NETWORK=ushuaia
TEZOS_RPC_URL=https://rpc.ushuaianet.tzkt.io
TEZOS_TZKT_API=https://api.ushuaianet.tzkt.io
TEZOS_FAUCET_URL=https://faucet.ushuaianet.tzkt.io/

# ── Resend (e-posta) ──────────────────────────────────────
RESEND_API_KEY=xxx_replace_me
RESEND_FROM_EMAIL=noreply@galatabaker.app
RESEND_FROM_NAME=GalataBaker

# ── Telegram (merkezi bot) ────────────────────────────────
TELEGRAM_BOT_TOKEN=xxx_replace_me
TELEGRAM_BOT_USERNAME=GalataBakerBot
TELEGRAM_BOT_PAIRING_SECRET=xxx_replace_me

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=xxx_replace_me_min_32_chars
JWT_EXPIRES_IN=7d
SESSION_SECRET=xxx_replace_me_min_32_chars

# ── Notifications throttle ────────────────────────────────
NOTIFICATION_THROTTLE_HOURS=1

# ── Rate limit ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE_IP=60
RATE_LIMIT_PER_MINUTE_PKH=30

# ── Octez baker (testnet) ────────────────────────────────
BAKER_PKH=tz4_xxx_replace_me
BAKER_SIGNER_URL=http://octez-signer:6732
BAKER_SIGNER_TIMEOUT=30

# ── Sentry (opsiyonel) ───────────────────────────────────
SENTRY_DSN=

# ── Admin (opsiyonel, ileride) ───────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
